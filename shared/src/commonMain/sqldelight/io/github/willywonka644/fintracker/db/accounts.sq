CREATE TABLE account (
    id              TEXT    NOT NULL PRIMARY KEY,
    name            TEXT    NOT NULL,
    type            TEXT AS io.github.willywonka644.fintracker.AccountType NOT NULL,
    billingStartDay INTEGER,
    spendingLimit   REAL,
    lastModifiedAt  INTEGER NOT NULL DEFAULT 0,
    deleted         INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM account WHERE deleted = 0;

selectAllIncludingDeleted:
SELECT * FROM account;

selectById:
SELECT * FROM account WHERE id = ?;

insert:
INSERT OR REPLACE INTO account (id, name, type, billingStartDay, spendingLimit, lastModifiedAt, deleted)
VALUES (?, ?, ?, ?, ?, ?, ?);

softDelete:
UPDATE account SET deleted = 1, lastModifiedAt = ? WHERE id = ?;

delete:
DELETE FROM account WHERE id = ?;

deleteAll:
DELETE FROM account;
