    <string name="help_title">Hilfe</string>
    <string name="help_account_title">Was ist ein Konto?</string>
    <string name="help_account_body">Ein Konto ist ein Ort, an dem du Geld verwaltest, z. B. Girokonto, Kreditkarte oder Sparkonto.</string>
    <string name="help_booking_title">Was ist eine Buchung?</string>
    <string name="help_booking_body">Eine Buchung ist eine einzelne Einnahme oder Ausgabe, die du manuell einträgst.</string>
    <string name="help_amounts_title">Positive und negative Beträge</string>
    <string name="help_amounts_body">Positive Beträge sind Einnahmen. Negative Beträge sind Ausgaben.</string>
    <string name="help_billing_title">Kreditkarten-Abrechnungszyklen</string>
    <string name="help_billing_body">Kreditkarten werden in festen Zyklen abgerechnet, z. B. vom 20. bis zum 20. des nächsten Monats.</string>
    <string name="help_limits_title">Ausgabenlimits</string>
    <string name="help_limits_body">Ein Ausgabenlimit zeigt dir, wie viel du pro Abrechnungszeitraum ausgeben möchtest.</string>
    <string name="help_recurring_title">Daueraufträge</string>
    <string name="help_recurring_body">Daueraufträge erstellen automatisch wiederkehrende Buchungen (wöchentlich, monatlich, jährlich). Du findest sie unter „Mehr“.</string>
    <string name="help_categories_title">Kategorien</string>
    <string name="help_categories_body">Jede Buchung kann einer Kategorie zugeordnet werden. Kategorien haben eine eigene Farbe und können direkt beim Erstellen einer Buchung angelegt werden.</string>
    <string name="help_analytics_title">Auswertungen</string>
    <string name="help_analytics_body">Die Auswertungen zeigen Saldo-Verlauf und Einnahmen/Ausgaben als Diagramme. Du kannst den Zeitraum frei wählen und Details per Fingertipp anzeigen.</string>
    <string name="help_csv_import_title">CSV-Import</string>
    <string name="help_csv_import_body">Importiere Buchungen aus CSV-Dateien (z. B. Kontoauszüge deiner Bank). Der Import erkennt Spalten automatisch.</string>
    <string name="help_qr_scan_title">QR-Code scannen</string>
    <string name="help_qr_scan_body">Scanne QR-Codes (z. B. Girocode auf Rechnungen), um Betrag und Empfänger automatisch zu übernehmen.</string>
    <string name="help_ocr_title">Beleg scannen (OCR)</string>
    <string name="help_ocr_body">Fotografiere einen Beleg — die App erkennt den Betrag automatisch und schlägt ihn als Buchung vor.</string>
    <string name="help_attachments_title">Belegfotos</string>
    <string name="help_attachments_body">Du kannst jeder Buchung ein Foto anhängen (Kamera oder Galerie). Angehängte Belege sind über die Buchungsdetails abrufbar.</string>
    <string name="help_installments_title">Ratenzahlungen</string>
    <string name="help_installments_body">Teile große Ausgaben in monatliche Raten auf. Die App erstellt alle Buchungen automatisch und zeigt den Fortschritt an.</string>
    <string name="help_reconciliation_title">Kontoabgleich</string>
    <string name="help_reconciliation_body">Gib deinen echten Kontostand ein — die App berechnet die Differenz und korrigiert den Basiswert automatisch.</string>
    <string name="help_audit_title">Buchungen prüfen</string>
    <string name="help_audit_body">Im Prüfmodus kannst du jede Buchung einzeln abhaken. Der Fortschritt wird als „X von Y geprüft" angezeigt.</string>
    <string name="help_quickadd_title">Schnelleingabe</string>
    <string name="help_quickadd_body">Der Plus-Button auf der Kontoübersicht öffnet die Schnelleingabe. So kannst du Buchungen direkt ohne Umwege erfassen.</string>
    <string name="help_backup_title">Backup &amp; Wiederherstellung</string>
    <string name="help_backup_body">Exportiere alle Daten als JSON-Backup oder Buchungen als CSV. Beim Wiederherstellen werden alle lokalen Daten ersetzt.</string>
