<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+ (API 31+). backup_rules.xml
   carries the same exclusion for older versions.

   The sync credentials are excluded from both paths (#89, #91):

   - cloud-backup: the key would otherwise travel to Google Drive with the rest
     of the app data, and a key in a backup is a key in every copy of it.
   - device-transfer: excluded as well, which means the key has to be entered
     again on a new phone. That is a deliberate trade — one field to refill
     against one fewer copy of the credential in circulation, and re-entering it
     is exactly the moment to notice whether the old phone still has access.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/server_sync.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/server_sync.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
