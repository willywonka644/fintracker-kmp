# Enforce LF in repository, regardless of OS
* text=auto eol=lf

# Kotlin/Gradle/Markdown explicitly
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Deploy-Dateien fuer den Pi (#96). Ein Shell-Skript mit CRLF scheitert dort
# mit "bad interpreter" — eine Meldung, die nicht auf die Ursache zeigt.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
